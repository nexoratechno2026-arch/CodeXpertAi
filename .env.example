# ============================================================================
# Nexora CodeLab & InterviewAI — Environment Variables
# ============================================================================
# Copy this file to .env and fill in values from your Firebase project.
# NEVER commit .env files with real values to version control.
# ============================================================================

# ── Firebase Web Configuration ──
# These values come from the Firebase Console → Project Settings → Your Apps.
# They are NOT server secrets. They identify the Firebase project to client SDKs.
# Access is controlled by Security Rules, App Check, and Authentication.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# ── Firebase App Check ──
# reCAPTCHA Enterprise site key — this is a public key, not a secret.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your_recaptcha_site_key_here

# ── Application ──
VITE_APP_NAME=Nexora CodeLab
VITE_APP_ENV=development

# ── Local Firebase Emulators (Optional) ──
# Set to 'true' to redirect Auth and Firestore calls to local emulators
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080

# ============================================================================
# CLOUD FUNCTIONS SECRETS (NOT stored here)
# ============================================================================
# The following secrets are managed via `firebase functions:secrets:set`
# and are ONLY accessible in Cloud Functions runtime. They must NEVER
# appear in VITE_ prefixed variables or any client-accessible location.
#
#   JUDGE0_API_URL        — Code execution provider endpoint
#   JUDGE0_API_KEY        — Code execution provider credential
#   AI_PROVIDER_API_KEY   — AI model provider API key (Gemini / OpenAI)
#
# To set these secrets:
#   firebase functions:secrets:set JUDGE0_API_URL
#   firebase functions:secrets:set JUDGE0_API_KEY
#   firebase functions:secrets:set AI_PROVIDER_API_KEY
# ============================================================================
